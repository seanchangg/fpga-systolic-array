# MAX 10 FPGA Development Kit (DK-DEV-10M50-A), PCB 100-0321401 Rev C.
# Pins come from the GHRD and from UG-01169 tables 4-8, 4-9 and 4-21.
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C6GES
set_global_assignment -name TOP_LEVEL_ENTITY array
set_global_assignment -name SYSTEMVERILOG_FILE systolic.sv
set_global_assignment -name SDC_FILE systolic.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name INTERNAL_FLASH_UPDATE_MODE "SINGLE IMAGE"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4

# CLK_50_MAX10, 50 MHz.
set_location_assignment PIN_M9 -to clk
set_instance_assignment -name IO_STANDARD "2.5 V" -to clk

# Keep unused pins safe.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
